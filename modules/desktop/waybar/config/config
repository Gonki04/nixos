{
  "position": "top",
  "spacing": 1,

  "modules-left": [
    "hyprland/workspaces", 
    "mpris"
  ],
  "modules-center": [
    "custom/left",
    "clock",
    "custom/right"
  ],
  "modules-right": [
    "cpu",
    "custom/gpu",
    "power-profiles-daemon",
    "network",
    "pulseaudio",
    "battery",
    "group/tray"
  ],

  "group/tray": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "children-class": "not-power",
      "transition-left-to-right": false
    },
    "modules": ["custom/trayicon", "tray", "memory"]
  }, 

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "●",
      "default": "●",
      "urgent": "●"
    }
  },
  "mpris": {
    "player": "playerctld",
    "format": "{dynamic}",
    "interval": 1,
    "dynamic-len": 48,
    "dynamic-order": ["artist", "title"]
  },

  "clock": {
    "format": "{:%a %d/%m/%Y · %H:%M}",
    "format-alt": "{:%A, %B %d · %H:%M}",
    "on-click": "mode",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "kitty -T wiremix wiremix"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "{profile}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "battery": {
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "format-time": "{H}:{M}",
    "interval": 5
  },
  "network": {
    "interface": "wl*",
    "format": "{icon}",
    "format-ethernet": "󰈀",
    "format-wifi": "{icon}",
    "format-disconnected": "󰖪",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format": "{ifname}({essid}): {ipaddr}",
    "on-click": "kitty -T nmtui nmtui",
    "interval": 3
  },
  "custom/trayicon": {
    "format": "󰶺"
  },
  "tray": {
    "icon-size": 14,
    "spacing": 5
  },
  "cpu": {
    "interval": 5,
    "format": " {usage}%",
    "max-length": 15
  },
  "custom/gpu": {
    "format": "󰢮 {}",
    "exec": "waybar-gpu-usage",
    "interval": 5,
    "tooltip": false,
    "max-length": 12
  },
  "memory": {
    "interval": 5,
    "format": "MEM {used:0.1f}G/{total:0.1f}G"
  },

  "custom/left": {
    "format": "[",
    "tooltip": false
  },
  "custom/right": {
    "format": "]",
    "tooltip": false
  }
}
