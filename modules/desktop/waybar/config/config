{
  "position": "top",
  "spacing": 4,

  "modules-left": [
    "hyprland/workspaces", 
    "mpris"
  ],
  "modules-center": [
    "custom/left",
    "clock",
    "custom/right"
  ],
  "modules-right": [
    "group/tray",
    "custom/left",
    "cpu",
    "custom/gpu",
    "power-profiles-daemon",
    "pulseaudio",
    "battery",
    "network",
    "custom/right"
  ],

  "group/tray": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "children-class": "not-power",
      "transition-left-to-right": false
    },
    "modules": ["custom/trayicon", "tray", "memory"]
  }, 

  "hyprland/workspaces": {
    "format": "{id}{icon}",
    "format-icons": {
      "active": "*",
      "default": ""
    }
  },
  "mpris": {
    "player": "playerctld",
    "format": "{dynamic}",
    "interval": 1,
    "dynamic-len": 100,
    "dynamic-order": ["artist", "title"]
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %B %d %H:%M}",
    "on-click": "mode",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "VOL muted",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "kitty -T wiremix wiremix"
  },
  "power-profiles-daemon": {
    "format": "{icon} {profile}",
    "tooltip-format": "Power profile: {profile}\nCPU driver: {cpu_driver}\nPlatform driver: {platform_driver}",
    "tooltip": true,
    "format-icons": {
      "default": "●",
      "performance": "▲",
      "balanced": "●",
      "power-saver": "▼"
    }
  },
  "battery": {
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "BAT {capacity}%",
    "format-charging": "CHG {capacity}%",
    "format-plugged": "PLUG {capacity}%",
    "format-time": "{H}:{M}",
    "interval": 5
  },
  "network": {
    "interface": "wl*",
    "format": "{ifname}",
    "format-ethernet": "{ipaddr}/{cidr} ",
    "format-wifi": "{icon}",
    "format-disconnected": "󰖪",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format": "{ifname}({essid}): {ipaddr}",
    "on-click": "kitty -T nmtui nmtui",
    "interval": 3
  },
  "custom/trayicon": {
    "format": "󰶺"
  },
  "tray": {
    "icon-size": 21,
    "spacing": 10
  },
  "cpu": {
    "interval": 5,
    "format": " {usage}%",
    "max-length": 15
  },
  "custom/gpu": {
    "format": "󰢮 {}",
    "exec": "waybar-gpu-usage",
    "interval": 5,
    "tooltip": false,
    "max-length": 12
  },
  "memory": {
    "interval": 5,
    "format": "MEM {used:0.1f}G/{total:0.1f}G"
  },

  "custom/left": {
    "format": "[",
    "tooltip": false
  },
  "custom/right": {
    "format": "]",
    "tooltip": false
  }
}
